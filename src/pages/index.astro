---
import BaseLayout from '../layouts/BaseLayout.astro';

const noticiasModules = import.meta.glob('../data/noticias-items/*.json', { eager: true });
const noticias = Object.values(noticiasModules).map((m) => m.default);
const ordenadas = [...noticias].sort((a, b) => new Date(b.fecha) - new Date(a.fecha));
const formatoFecha = (f) => new Date(f).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const galeriaModules = import.meta.glob('../data/galeria-items/*.json', { eager: true });
const galeria = Object.values(galeriaModules)
  .map((m) => m.default)
  .sort((a, b) => (a.orden ?? 999) - (b.orden ?? 999));
---
<BaseLayout title="Inicio">
  <section class="hero-somiama section" style="position:relative; overflow:hidden;">
    <div class="container" style="padding:2.5rem 24px; color:#fff; position:relative;">
      <img
        src="/images/logo-somiama-blanco.png"
        alt="SOMIAMA — Sociedad de Medicina Intensiva de Madrid"
        style="height:56px; width:auto; margin-bottom:18px; display:block;"
      />
      <p style="font-family:var(--font-display); font-weight:900; font-size:1.6rem; margin:0 0 8px;">Medicina Intensiva de Madrid</p>
      <p style="color:#cdd8e2; margin:0 0 20px;">Recursos, formación y herramientas clínicas para profesionales del paciente crítico.</p>
    </div>
  </section>

  {galeria.length > 0 && (
    <section class="section" style="padding-top:0; padding-bottom:0;">
      <div class="container" style="padding-top:1.5rem; padding-bottom:0;">
        <div id="galeria-home" style="position:relative; width:100%; aspect-ratio:16/6; border-radius:12px; overflow:hidden; background:var(--surface);">
          {galeria.map((foto, i) => (
            <img
              src={foto.imagen}
              alt={foto.titulo || ''}
              class="galeria-slide"
              data-index={i}
              style={`position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:${i === 0 ? 1 : 0}; transition:opacity 1.2s ease;`}
            />
          ))}
          {galeria.length > 1 && (
            <div style="position:absolute; bottom:12px; left:0; right:0; display:flex; justify-content:center; gap:6px;">
              {galeria.map((_, i) => (
                <span class="galeria-dot" data-dot={i} style={`width:8px; height:8px; border-radius:50%; background:#fff; opacity:${i === 0 ? 0.9 : 0.4}; transition:opacity 0.3s;`}></span>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <h2>Últimas noticias</h2>
      <div style="display:flex; flex-direction:column; gap:12px;">
        {ordenadas.map(n => (
          <a href={n.enlace} class="card" style="text-decoration:none; color:inherit; display:block;">
            <p style="font-size:0.8rem; color:var(--text-secondary); margin:0 0 4px;">{formatoFecha(n.fecha)}</p>
            <h3 style="margin:0 0 4px;">{n.titulo}</h3>
            <p style="margin:0; color:var(--text-secondary);">{n.texto}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>Herramientas clínicas</h2>
      <p style="color:var(--text-secondary); margin-top:-8px;">Las más consultadas de todo el sitio.</p>
      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <a class="badge" href="/herramientas#apache2">APACHE II</a>
        <a class="badge" href="/herramientas#sofa">SOFA</a>
        <a class="badge" href="/herramientas#saps2">SAPS II</a>
        <a class="badge" href="/herramientas#saps3">SAPS III</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Carrusel simple de la galería de la home: rota sola cada 5 segundos,
  // sin ninguna librería externa.
  const slides = document.querySelectorAll('.galeria-slide');
  const dots = document.querySelectorAll('.galeria-dot');
  if (slides.length > 1) {
    let actual = 0;
    setInterval(() => {
      slides[actual].style.opacity = '0';
      if (dots[actual]) dots[actual].style.opacity = '0.4';
      actual = (actual + 1) % slides.length;
      slides[actual].style.opacity = '1';
      if (dots[actual]) dots[actual].style.opacity = '0.9';
    }, 5000);
  }
</script>

<style>
  .hero-somiama {
    background-color: var(--navy);
    background-image: url('/images/logo-icon.png');
    background-repeat: repeat;
    background-size: 120px 120px;
    background-position: center;
  }
  .hero-somiama::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--navy);
    opacity: 0.86;
  }
  .hero-somiama .container {
    position: relative;
    z-index: 1;
  }
</style>
