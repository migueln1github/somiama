---
import BaseLayout from '../layouts/BaseLayout.astro';

const documentosModules = import.meta.glob('../data/documentos-items/*.json', { eager: true });
const documentos = Object.values(documentosModules).map((m) => m.default);
const ordenados = [...documentos].sort((a, b) => new Date(b.fecha || 0) - new Date(a.fecha || 0));
---
<BaseLayout title="Documentos">
  <section class="section">
    <div class="container">
      <h1>Documentos</h1>
      <p style="color:var(--text-secondary);">
        Estatutos, libros de abstracts de congresos anteriores y otros documentos de la Sociedad,
        alojados directamente en este sitio.
      </p>

      {ordenados.length === 0 && (
        <div class="card">
          <p style="color:var(--text-secondary); margin:0;">
            Todavía no hay documentos publicados. Se añaden desde el panel de administración (<code>/admin</code>),
            sección "Documentos".
          </p>
        </div>
      )}

      <div style="display:flex; flex-direction:column; gap:10px;">
        {ordenados.map(doc => (
          <div class="card" style="display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;">
            <div>
              <h3 style="margin:0 0 4px;">{doc.titulo}</h3>
              {doc.descripcion && <p style="margin:0; color:var(--text-secondary); font-size:14px;">{doc.descripcion}</p>}
            </div>
            <a class="btn" href={doc.archivo} target="_blank">Descargar</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
